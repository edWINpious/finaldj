# Copy to .env and replace every value. .env is git-ignored.
# Allowed characters in these passwords: letters, digits, _ # . -
MARIADB_ROOT_PASSWORD=change-me-root
CONTROLLER_DB_PASSWORD=change-me-controller
# The attacker-facing decoy password is meant to be guessable, but it is still set here so
# the repository holds no credential.
DECOY_DB_PASSWORD=change-me-decoy
